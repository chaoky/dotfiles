        pandoc
        fzf
        bat
        socat
        coreutils
        wakatime-cli
        tldr
        cmake
        gcc
        python3
        tree-sitter
        lazygit
        cargo
        lua
        lua51Packages.luarocks-nix
        deno
        dasel
        prettierd
